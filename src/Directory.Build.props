<Project>
  <PropertyGroup>
    <!-- Use the repository feed configuration for IDE restores as well as CLI builds. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../NuGet.Config</RestoreConfigFile>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <!-- Common and Windows are released together with one package version. -->
    <Version>1.3.0</Version>
  </PropertyGroup>
</Project>
