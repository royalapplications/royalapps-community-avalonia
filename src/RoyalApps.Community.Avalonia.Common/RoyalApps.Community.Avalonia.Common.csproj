<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>RoyalApps.Community.Avalonia.Common</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>RoyalApps_1024.png</PackageIcon>
    <RepositoryUrl>https://github.com/royalapplications/royalapps-community-avalonia</RepositoryUrl>
    <PackageTags>Avalonia;Controls;Spinner;Behaviors</PackageTags>
    <Description>Provides common controls and behaviors for Avalonia applications.</Description>
    <Company>Royal Apps GmbH</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.ToString(yyyy)), Royal Apps GmbH, Austria</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>RoyalApps.Community.Avalonia.Common</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/public/assets/RoyalApps_1024.png" Pack="true" PackagePath="/" />
    <PackageReference Include="Avalonia" />
    <InternalsVisibleTo Include="RoyalApps.Community.Avalonia.Common.Tests" />
  </ItemGroup>

</Project>
