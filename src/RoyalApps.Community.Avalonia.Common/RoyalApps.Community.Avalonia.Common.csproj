<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>RoyalApps.Community.Avalonia.Common</Product>
    <Description>Provides common controls and behaviors for Avalonia applications.</Description>
    <Company>Royal Apps GmbH</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.ToString(yyyy)), Royal Apps GmbH, Austria</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>RoyalApps.Community.Avalonia.Common</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

</Project>
